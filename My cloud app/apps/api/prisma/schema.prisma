generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  googleAccounts GoogleAccount[]
  virtualFiles VirtualFile[]
  folders      VirtualFolder[]
  uploadJobs   UploadJob[]
}

model GoogleAccount {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleUserId          String
  googleEmail           String
  encryptedRefreshToken String?
  tokenMetadata         Json?
  status                AccountStatus @default(PENDING)
  driveTotalBytes       BigInt?
  driveUsedBytes        BigInt?
  lastSyncedAt          DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  virtualFiles          VirtualFile[]
  syncJobs              SyncJob[]
  @@unique([userId, googleUserId])
  @@index([userId, status])
}

model VirtualFolder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, parentId])
}

model VirtualFile {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleAccountId   String
  googleAccount     GoogleAccount @relation(fields: [googleAccountId], references: [id], onDelete: Cascade)
  googleFileId      String
  name              String
  mimeType          String
  sizeBytes         BigInt?
  parentVirtualId   String?
  checksum          String?
  providerModifiedAt DateTime?
  status            FileStatus @default(ACTIVE)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@unique([googleAccountId, googleFileId])
  @@index([userId, name])
  @@index([userId, status])
}

model GmailMessage {
  id             String   @id @default(cuid())
  userId         String
  googleAccountId String
  gmailMessageId String
  threadId       String?
  sender         String?
  subject        String?
  receivedAt     DateTime?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([googleAccountId, gmailMessageId])
  @@index([userId, receivedAt])
}

model SyncJob {
  id               String   @id @default(cuid())
  userId           String
  googleAccountId  String
  googleAccount    GoogleAccount @relation(fields: [googleAccountId], references: [id], onDelete: Cascade)
  service          String
  jobType          String
  status            JobStatus @default(QUEUED)
  attempts          Int @default(0)
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([status, createdAt])
}

model UploadJob {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName              String
  sizeBytes             BigInt
  targetGoogleAccountId String?
  status                JobStatus @default(QUEUED)
  progress              Int @default(0)
  error                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@index([userId, createdAt])
}

enum AccountStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  REAUTH_REQUIRED
  ERROR
}
enum FileStatus {
  ACTIVE
  TRASHED
  UNAVAILABLE
}
enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}
